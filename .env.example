# Copy to .env.local. Never committed.

# Your OpenAI key, used only for the "Generate with AI" button.
OPENAI_API_KEY=

# Optional. By default the app asks your account which image models it has and
# uses the newest. Set this to pin a specific one.
# OPENAI_IMAGE_MODEL=gpt-image-1.5

# Where packs get installed. Defaults to the macOS shared location.
# NI_RESOURCES_IMAGE_DIR=/Users/Shared/NI Resources/image

# Where the app keeps your saved packs.
# ICONMASCHINE_HOME=~/.iconmaschine

# Your SerpAPI key, used only by the "Search for a logo" tab.
# Get one at https://serpapi.com - the free tier covers ~100 searches a month.
SERPAPI_API_KEY=
