{
  "name": "iconmaschine",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev -p ${PORT:-4321}",
    "build": "next build",
    "start": "next start -p ${PORT:-4321}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/ts-resolver.mjs --test tests/*.test.mts",
    "app": "ICONMASCHINE_STANDALONE=1 next build && node scripts/prepare-app.mjs && electron-builder --mac --arm64 && scripts/smoke-app.sh",
    "app:check": "node scripts/check-app.mjs"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "typescript": "5.7.2"
  }
}
